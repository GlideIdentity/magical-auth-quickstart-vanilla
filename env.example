# Glide API Configuration
# Get your API key from Glide Identity dashboard
GLIDE_API_KEY=your_api_key_here

# Server Port (serves both API and frontend)
PORT=3000

# Debug Logging (optional)
# Set to 'true' to enable debug logging in the server
GLIDE_DEBUG=false

# Log format (optional)
# Options: 'pretty' (boxed format), 'json', 'compact'
GLIDE_LOG_FORMAT=pretty
